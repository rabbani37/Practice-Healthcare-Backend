
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f5f7fa; font-family: Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0"
        style="background-color: #f5f7fa; padding: 40px 15px;">

        <tr>
            <td align="center">

                <!-- Email Container -->
                <table width="100%" cellpadding="0" cellspacing="0"
                    style="max-width: 500px; background-color: #ffffff; border-radius: 8px; overflow: hidden;">

                    <!-- Header -->
                    <tr>
                        <td style="padding: 28px 30px; border-bottom: 1px solid #eeeeee;">
                            <h2 style="margin: 0; color: #111827; font-size: 22px;">
                                Verify Your Email
                            </h2>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 30px;">

                            <p style="margin: 0 0 15px; color: #374151; font-size: 15px; line-height: 1.6;">
                                Hello <strong><%= name %></strong>,
                            </p>

                            <p style="margin: 0 0 15px; color: #374151; font-size: 15px; line-height: 1.6;">
                                Thank you for registering with us. Please use the verification code below to verify your email: <strong> <%= email %> </strong> .
                            </p>

                            <!-- OTP -->
                            <div style="margin: 25px 0; text-align: center;">
                                <div style="
                                    display: inline-block;
                                    padding: 14px 28px;
                                    background-color: #f3f4f6;
                                    border: 1px solid #e5e7eb;
                                    border-radius: 6px;
                                    color: #111827;
                                    font-size: 28px;
                                    font-weight: bold;
                                    letter-spacing: 6px;
                                ">
                                    <%= OTP %>
                                </div>
                            </div>

                            <p style="margin: 0 0 10px; color: #6b7280; font-size: 13px; line-height: 1.5;">
                                This verification code will expire in  <%= expirationMinutes %> Minutes.
                                Please do not share this code with anyone.
                            </p>

                            <p style="margin: 25px 0 0; color: #374151; font-size: 14px; line-height: 1.5;">
                                If you did not create an account, you can safely ignore this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
                            padding: 20px 30px;
                            background-color: #fafafa;
                            border-top: 1px solid #eeeeee;
                            text-align: center;
                        ">
                            <p style="margin: 0; color: #9ca3af; font-size: 12px;">
                                This is an automated email. Please do not reply.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>
</html>

